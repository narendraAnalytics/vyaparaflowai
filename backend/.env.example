# Copy to .env and fill in real values. Never commit the real .env file.

ENV=development
LOG_LEVEL=INFO

# Neon Postgres — pooled URL for the app, direct URL for Alembic migrations.
# Get both from: Neon console > project > Connect, or `mcp__neon__get_connection_string`.
DATABASE_URL=postgresql+psycopg://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DIRECT_DATABASE_URL=postgresql+psycopg://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Upstash Redis — "Redis client" connection string from the Upstash console
# (NOT the REST API URL/token, this app uses the redis-py protocol client).
REDIS_URL=rediss://default:password@example-endpoint.upstash.io:6379


# Shared secret n8n uses to call this API (separate from user JWTs).
N8N_API_KEY=change-me

# JWT signing secret for user auth (Phase 2).
JWT_SECRET=change-me
