      ]
    },
    "Build FastAPI Request": { "main": [[{ "node": "Call Sales Order API", "type": "main", "index": 0 }]] },
    "Build Failure Alert": { "main": [[{ "node": "Notify Failure", "type": "main", "index": 0 }]] },
    "Call Sales Order API": {
