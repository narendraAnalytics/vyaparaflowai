      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [770, 140],
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const j = $json;\nconst lines = j.lines.map(l => `${l.product_id}: received ${l.received_quantity}, accepted ${l.accepted_quantity}, rejected ${l.rejected_quantity}, damaged ${l.damaged_quantity}`).join('\\n');\nreturn [{ json: { text: `GRN ${j.grn_number} has short/damaged lines - please review.\\nPO status: ${j.purchase_order_status}\\nLines: ${lines}` } }];"
      }
    },
