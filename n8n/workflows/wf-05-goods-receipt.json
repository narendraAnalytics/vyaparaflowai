        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $json;\nconst poId = $('Webhook').item.json.body.purchase_order_id;\nconst message = (item.error_message || item.message || 'unknown error').toString().slice(0, 500);\nreturn [{ json: { text: `WF-05 could not retry reservation for sales order ${poId}'s GRN: ${message}` } }];"
      }
