      "position": [1980, -200],
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const inv = $('Create Customer Invoice').item.json;\nreturn [{ json: { text: `Invoice emailed to customer.\\nInvoice: ${inv.invoice_number}\\nCustomer: ${inv.customer_name} (${inv.customer_email})\\nAmount: Rs.${inv.total}` } }];"
      }
    },
