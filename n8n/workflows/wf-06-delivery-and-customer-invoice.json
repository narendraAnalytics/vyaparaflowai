    },
    {
      "id": "build_failure_alert",
      "name": "Build Failure Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 260],
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $json;\nconst soId = $('Webhook').item.json.body.sales_order_id;\nconst message = (item.error_message || (item.error && item.error.message) || item.message || 'unknown error').toString().slice(0, 500);\nreturn [{ json: { text: `WF-06 could not finish emailing invoice for SO ${soId}: ${message}` } }];"
      }
    },
