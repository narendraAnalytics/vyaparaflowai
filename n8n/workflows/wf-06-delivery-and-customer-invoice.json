        "jsCode": "const id = $('Create Customer Invoice').item.json.customer_invoice_id;\nreturn [{ json: { method: 'POST', path: `/customer-invoices/${id}/mark-sent`, idempotencyKey: `wf06-mark-sent-${id}` } }];"
      }
    },
    {
      "id": "http_mark_sent",
