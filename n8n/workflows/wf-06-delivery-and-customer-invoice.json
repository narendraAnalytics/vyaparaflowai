        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const key = $('Webhook').item.json.headers['idempotency-key'];\nreturn [{ json: { method: 'POST', path: '/customer-invoices', idempotencyKey: key + '-invoice', body: { delivery_id: $json.delivery_id } } }];"
      }
    },
    {
      "id": "http_create_invoice",
