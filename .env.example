# Root-level env for docker-compose variable substitution (n8n services only —
# the backend service still reads its own vars from backend/.env). Copy to
# .env at the repo root and fill in real values; .env is gitignored.

# Generate once with: python -c "import secrets; print(secrets.token_hex(32))"
# Copy the SAME value to every n8n process (main/worker/webhook) — a mismatch
# means workers can't decrypt credentials.
N8N_ENCRYPTION_KEY=change-me-64-char-hex

# n8n's own Postgres (separate from the app's Neon DB — separate schemas,
# separate blast radius).
N8N_POSTGRES_PASSWORD=change-me

# Editor UI basic auth.
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me

# BullMQ queue Redis — reuse the existing Upstash instance backend/.env's
# REDIS_URL points at (don't spin up a second Redis). n8n's queue mode takes
# discrete host/port/user/password vars, not a single connection URL — parse
# these out of REDIS_URL (rediss://default:<token>@<host>:6379).
N8N_REDIS_HOST=example-endpoint.upstash.io
N8N_REDIS_PORT=6379
N8N_REDIS_USERNAME=default
N8N_REDIS_PASSWORD=change-me

# Resend (outbound email, WF-04/WF-06). Not read by docker-compose/n8n env
# vars — goes into n8n's own credential store (roadmap.txt 3.3), kept here
# only for documentation.
RESEND_API_KEY=re_your_resend_api_key

# ngrok public tunnel to n8n-webhook (port 5679) — only needed for local
# dev features that hand a callback URL to a third party (Telegram's
# sendAndWait inline buttons, WF-03). Get it with:
#   ngrok http 5679
#   curl http://127.0.0.1:4040/api/tunnels
# Changes every ngrok restart. Falls back to http://localhost:5679/ if
# unset (fine for everything except real Telegram button callbacks). Not
# needed once actually deployed — n8n gets a real public URL then.
N8N_WEBHOOK_PUBLIC_URL=https://your-ngrok-subdomain.ngrok-free.app/
